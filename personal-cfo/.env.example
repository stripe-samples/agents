# Required: a Link access token. See README.md to create one.
# Scopes: userinfo:read, plus the read_link_transactions, read_external_transactions,
# read_balances, and read_source_details source actions. Add payment_methods.agentic
# only if the agent should create spend requests when you ask.
# Replace expired tokens here and restart; this sample does not refresh them.
LINK_ACCESS_TOKEN=

# Required for the configured OpenRouter model.
OPENROUTER_API_KEY=
