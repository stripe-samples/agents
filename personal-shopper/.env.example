# Required: a Link wallet access token obtained through Link OAuth.
# Scopes: payment_methods.agentic for purchases, userinfo:read for profile access.
# Financial insights also need the relevant financial-data scopes and source permissions.
# Replace expired tokens here and restart; this sample does not refresh them.
LINK_ACCESS_TOKEN=

# Required for the configured OpenRouter model.
OPENROUTER_API_KEY=

# Required for browser access: https://dashboard.onkernel.com/api-keys
KERNEL_API_KEY=
