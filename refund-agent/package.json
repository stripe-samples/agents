{
  "name": "stripe-refund-agent",
  "version": "0.0.0",
  "private": true,
  "description": "An eve agent for reviewing and approving Stripe refunds",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "start": "eve start",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.43",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@vercel/connect": "0.9.0",
    "ai": "^7.0.26",
    "eve": "^0.42.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ]
  },
  "overrides": {
    "ai": "^7.0.26"
  },
  "engines": {
    "node": "24.x"
  }
}
