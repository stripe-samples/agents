{
  "name": "stripe-refund-specialist",
  "version": "0.0.0",
  "private": true,
  "description": "An eve agent for reviewing and approving Stripe refunds",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "start": "eve start",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.81",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@vercel/connect": "2.3.4",
    "ai": "^7.0.122",
    "eve": "^0.68.0",
    "just-bash": "^3.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "~26.6.3",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ],
    "overrides": {
      "undici@8.9.0": "8.11.2"
    }
  },
  "overrides": {
    "ai": "^7.0.26"
  },
  "engines": {
    "node": "24.x"
  }
